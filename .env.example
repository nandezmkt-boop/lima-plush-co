# ─────────────────────────────────────────────────────────────
# LIMA PLUSH CO. — Variables de entorno
# Copia este archivo como ".env.local" y completa los valores.
# ".env.local" nunca se sube al repositorio (ver .gitignore).
# ─────────────────────────────────────────────────────────────

# URL pública del sitio (usada en SEO, sitemap y Open Graph)
NEXT_PUBLIC_SITE_URL=https://limaplushco.vercel.app

# ── Formulario de solicitud de presupuesto ─────────────────────
# Clave de API de Resend (https://resend.com) para el envío de emails.
# Mientras no exista, el formulario sigue funcionando: los datos quedan
# registrados en los logs del servidor y el usuario ve confirmación,
# pero no se envía email real hasta configurar esta clave.
RESEND_API_KEY=

# Email remitente verificado en Resend (dominio propio verificado).
# Si no se configura, se usa el remitente de pruebas de Resend.
RESEND_FROM_EMAIL=Lima Plush Co. <onboarding@resend.dev>

# Email(s) donde debe llegar cada solicitud de presupuesto.
# La propietaria confirmará el email definitivo — mientras tanto se
# usa el contacto comercial del catálogo como valor por defecto.
QUOTE_TO_EMAIL=limaplushco@gmail.com

# ── WhatsApp Business ───────────────────────────────────────────
# Número en formato internacional, solo dígitos (sin "+", espacios ni guiones).
# Ejemplo: 51987654321
NEXT_PUBLIC_WHATSAPP_NUMBER=51987654321
